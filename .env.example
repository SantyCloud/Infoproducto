# Configuración y claves secretas.
# No hace falta copiarlo a mano: `php bin/instalar.php` crea el .env a partir de este archivo.
# NUNCA subas el .env a Git.
# Si un valor tiene espacios o el símbolo #, ponlo entre comillas.

# --- General ---
# local = tu computadora · produccion = Hostinger
ENTORNO=local
# Dirección de la web, sin barra al final (en producción: https://tudominio.com)
URL_SITIO=http://localhost:8000
# Clave secreta para firmar cookies y enlaces (la genera bin/instalar.php)
CLAVE_APP=
ZONA_HORARIA=America/Guayaquil
# Archivo de la base de datos (relativo a la carpeta del proyecto)
RUTA_BD=storage/base.sqlite
# true solo si usas un CDN/proxy delante de la web (la IP real llega en X-Forwarded-For)
CONFIAR_PROXY=false

# --- Panel admin (/admin) ---
# Usuario y contraseña se configuran con: php bin/crear-admin.php
ADMIN_USUARIO=
ADMIN_CLAVE_HASH=

# --- Emails con Resend (https://resend.com) ---
# Sin clave, los emails no se envían: se guardan en storage/logs/ para poder probar.
RESEND_API_KEY=
EMAIL_REMITENTE="Nombre del curso <acceso@tudominio.com>"
EMAIL_RESPONDER_A=

# --- Meta: Pixel y API de Conversiones ---
# Sin META_PIXEL_ID no se carga el Pixel; sin META_CAPI_TOKEN no se envían eventos desde el servidor.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Código de prueba del Administrador de eventos (quítalo cuando termines de probar)
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v25.0
