# Configuración y claves secretas.
# No hace falta copiarlo a mano: `php bin/instalar.php` crea el .env a partir de este archivo.
# NUNCA subas el .env a Git.
# Si un valor tiene espacios o el símbolo #, ponlo entre comillas.

# --- General ---
# local = tu computadora · produccion = Hostinger
ENTORNO=local
# Dirección de la web, sin barra al final (en producción: https://tudominio.com)
URL_SITIO=http://localhost:8000
# Clave secreta para firmar cookies y enlaces (la genera bin/instalar.php)
CLAVE_APP=
ZONA_HORARIA=America/Guayaquil
# Archivo de la base de datos (relativo a la carpeta del proyecto)
RUTA_BD=storage/base.sqlite

# --- Panel admin (fase 3) ---
ADMIN_USUARIO=
ADMIN_CLAVE_HASH=

# --- Emails con Resend (fase 5) ---
RESEND_API_KEY=
EMAIL_REMITENTE="Nombre del curso <acceso@tudominio.com>"
EMAIL_RESPONDER_A=

# --- Meta: Pixel y API de Conversiones (fase 6) ---
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
